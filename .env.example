# Copy this file to .env and fill in your values.

# Firebase project ID (e.g. "hostel-mess-attendance")
PROJECT_ID=your-firebase-project-id

# Path to the Firebase service account JSON file (gitignored)
FIREBASE_CREDENTIALS=service-account.json

# Admin dashboard password
ADMIN_PASSWORD=change-me

# Secret key used to sign session cookies
FLASK_SECRET_KEY=change-me-too

# Optional: timezone for the "current date" used in attendance records
# Leave empty to use the server's local date. Examples: Asia/Kolkata, UTC
TZ=
